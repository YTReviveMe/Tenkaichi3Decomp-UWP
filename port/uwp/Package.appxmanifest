<?xml version="1.0" encoding="utf-8"?>
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
         xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
         xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
         IgnorableNamespaces="uap mp">
  <Identity Name="Tenkaichi3DecompUWP.PlatformCheck" Publisher="CN=Revive" Version="0.0.1.0" ProcessorArchitecture="x64" />
  <mp:PhoneIdentity PhoneProductId="8e5143df-23b5-4cc1-a205-59c932437ce1"
                    PhonePublisherId="00000000-0000-0000-0000-000000000000" />
  <Properties>
    <DisplayName>Tenkaichi 3 Xbox Platform Check</DisplayName>
    <PublisherDisplayName>Revive</PublisherDisplayName>
    <Logo>assets\StoreLogo.png</Logo>
  </Properties>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>
  <Resources><Resource Language="en-us" /></Resources>
  <Applications>
    <Application Id="App" Executable="Tenkaichi3DecompUWP.exe" EntryPoint="Tenkaichi3DecompUWP.App">
      <uap:VisualElements DisplayName="Tenkaichi 3 Xbox Platform Check"
          Description="Xbox Dev Mode platform check"
          BackgroundColor="#101B32" Square150x150Logo="assets\Square150x150Logo.png"
          Square44x44Logo="assets\Square44x44Logo.png">
        <uap:SplashScreen Image="assets\SplashScreen.png" BackgroundColor="#101B32" />
      </uap:VisualElements>
    </Application>
  </Applications>
  <Capabilities>
    <uap:Capability Name="removableStorage" />
  </Capabilities>
</Package>
